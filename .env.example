# ─── Database ───
# LOCAL DEV (default): uses SQLite — just set DATABASE_URL to a file path:
#   DATABASE_URL=file:./dev.db
#
# VERCEL / PRODUCTION: uses Neon PostgreSQL — set both URLs from your Neon dashboard:
#   DATABASE_URL           = Pooled connection (used by the app via @prisma/adapter-neon)
#   DATABASE_URL_UNPOOLED  = Direct/unpooled connection (used by Prisma CLI for migrations/db push)
# Neon provides both strings on the project dashboard — copy them exactly.
DATABASE_URL=file:./dev.db
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# ─── Vercel Deployment Checklist ───
# 1. Create a Neon database at https://neon.tech
# 2. Copy the two connection strings from the Neon dashboard:
#      DATABASE_URL           (pooled — hostname contains "-pooler")
#      DATABASE_URL_UNPOOLED  (direct — no pooler in hostname)
# 3. Set these Vercel environment variables:
#      DATABASE_URL           = <pooled connection string from Neon>
#      DATABASE_URL_UNPOOLED  = <direct connection string from Neon>
#      ENCRYPTION_KEY         = (openssl rand -hex 32)
#      ADMIN_PASSWORD         = (your chosen password)
#      CRON_SECRET            = (openssl rand -hex 16)
# 4. Deploy — the vercel-build script runs prisma generate + db push + next build
# 5. Set up cron-job.org jobs:
#      Tick (every 5 min):        POST https://your-app.vercel.app/api/cron/tick
#      Maintenance (every 15 min): POST https://your-app.vercel.app/api/cron/maintenance
#      Both with header: x-cron-secret: <CRON_SECRET value>

# ─── Security ───
# AES-256-GCM key for encrypting stored X cookies (generate: openssl rand -hex 32)
ENCRYPTION_KEY=
# Initial admin password (changed after first login)
ADMIN_PASSWORD=
# Secret to verify cron-job.org requests (generate: openssl rand -hex 16)
CRON_SECRET=
