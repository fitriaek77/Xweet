# ═══════════════════════════════════════════════════════════════
# Xweet — Environment Variables
# Copy this file to .env and fill in the values.
# ═══════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────
#
# LOCAL DEV (default): uses SQLite — just set DATABASE_URL to a file path:
#   DATABASE_URL=file:./dev.db
#
# PRODUCTION (Neon PostgreSQL): set both URLs from your Neon dashboard:
#   DATABASE_URL           = Pooled connection (hostname contains "-pooler")
#   DATABASE_URL_UNPOOLED  = Direct connection (no pooler in hostname)
#
# Create a free Neon database at https://neon.tech
#
DATABASE_URL=file:./dev.db
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# ─── Security ─────────────────────────────────────────────────
#
# AES-256-GCM encryption key for storing X (Twitter) cookies securely.
# MUST be exactly 64 hex characters (32 bytes).
# Generate with:  openssl rand -hex 32
# ⚠️  REQUIRED — the app will crash on any encryption/decryption if missing.
#
ENCRYPTION_KEY=

# Initial admin password for first-time login.
# If left empty, you'll set a password on first visit to the login page.
# Optional — only used if you want to pre-seed the admin password.
#
ADMIN_PASSWORD=

# Shared secret to verify incoming cron requests (e.g. from cron-job.org).
# Generate with:  openssl rand -hex 16
# ⚠️  REQUIRED in production — cron endpoints (/api/cron/*) return 403 without it.
#
CRON_SECRET=

# ─── Backblaze B2 Storage (Media Uploads) ─────────────────────
#
# Used to temporarily store media (images, videos, GIFs) attached to
# scheduled tweets. Files are deleted after posting or cancellation.
#
# Create a B2 bucket at https://console.backblaze.com
# Recommended: create an application key restricted to the "media/" prefix
# with Read + Write permissions only.
#
# ⚠️  All three are REQUIRED if you want media upload to work.
#     The app will throw at upload time if B2_BUCKET_NAME is missing.
#
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
# B2_BUCKET_REGION=us-west-004

# ─── Deployment Checklist (Vercel + Neon) ─────────────────────
#
# 1. Create a Neon database at https://neon.tech
# 2. Copy the two connection strings from the Neon dashboard:
#      DATABASE_URL           (pooled — hostname contains "-pooler")
#      DATABASE_URL_UNPOOLED  (direct — no pooler in hostname)
# 3. Create a Backblaze B2 bucket and application key at https://console.backblaze.com
# 4. Set these Vercel environment variables:
#      DATABASE_URL           = <pooled connection string from Neon>
#      DATABASE_URL_UNPOOLED  = <direct connection string from Neon>
#      ENCRYPTION_KEY         = $(openssl rand -hex 32)
#      CRON_SECRET            = $(openssl rand -hex 16)
#      B2_KEY_ID              = <B2 application key ID>
#      B2_APP_KEY             = <B2 application key secret>
#      B2_BUCKET_NAME         = <your-bucket-name>
#      B2_BUCKET_REGION       = <your-b2-region>  (defaults to us-west-004)
# 5. Deploy — the vercel-build script runs prisma generate + db push + next build
# 6. Set up cron-job.org jobs:
#      Tick (every 5 min):        POST https://your-app.vercel.app/api/cron/tick
#      Maintenance (every 15 min): POST https://your-app.vercel.app/api/cron/maintenance
#      Both with header: x-cron-secret: <CRON_SECRET value>
